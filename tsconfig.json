{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true
  },
  "include": ["index.ts", "core/**/*.ts", "providers/**/*.ts", "preflight/**/*.ts", "status/**/*.ts", "test/**/*.ts", "tuners/**/*.ts"]
}
